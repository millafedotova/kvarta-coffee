# Set only when a real deployment URL exists.
SITE_URL=

# Exact comma-separated browser origins. Required in deployed environments.
# Local example: http://127.0.0.1:3000,http://localhost:3000
LEAD_ALLOWED_ORIGINS=

# Server-only pooled runtime connection. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=

# Direct owner connection, used only by the explicit migration command.
MIGRATION_DATABASE_URL=

# Dedicated disposable database with a name ending in _test. Never production.
TEST_DATABASE_URL=
